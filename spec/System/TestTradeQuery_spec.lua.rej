+	describe("purchase search filters", function()
+		local dkjson = require "dkjson"
+		local tradeHelpers = require "Classes.TradeHelpers"
+		local originalEncode, originalCopy, originalOpenURL, encodedQuery
+
+		before_each(function()
+			originalEncode, originalCopy, originalOpenURL = tradeHelpers.B64GzipEncode, Copy, OpenURL
+			tradeHelpers.B64GzipEncode = function(query)
+				encodedQuery = dkjson.decode(query)
+				return "encoded"
+			end
+			Copy, OpenURL = function() end, function() end
+			mock_tradeQuery.itemsTab.activeItemSet = {}
+			mock_tradeQuery.itemsTab.slots = {}
+			mock_tradeQuery.slotTables[1] = { slotName = "Ring 1" }
+			mock_tradeQuery:PriceItemRowDisplay(1, nil, 0, 20)
+			mock_tradeQuery.pbLeague = "Standard"
+			mock_tradeQuery.itemIndexTbl[1] = 1
+			mock_tradeQuery.resultTbl[1] = { { trader = "ExampleAccount", weight = "100", priceType = "~b/o" } }
+		end)
+
+		after_each(function()
+			tradeHelpers.B64GzipEncode, Copy, OpenURL = originalEncode, originalCopy, originalOpenURL
+		end)
+
+		for _, group in ipairs({
+			{ type = "and", filters = {} },
+			{ type = "count", value = { min = 1 }, filters = {} },
+			{ type = "weight", value = { min = 10 }, filters = {} },
+		}) do
+			it("preserves " .. group.type .. " group semantics when opening a purchase search", function()
+				mock_tradeQuery.lastQueries[1] = dkjson.encode({ query = { stats = { group } } })
+				mock_tradeQuery.controls.whisperButton1.onClick()
+				if group.type == "weight" then
+					assert.same({ min = 99, max = 101 }, encodedQuery.stats[1].value)
+				else
+					assert.same(group, encodedQuery.stats[1])
+				end
+				assert.same({ input = "ExampleAccount" }, encodedQuery.filters.trade_filters.filters.account)
+			end)
+		end
+	end)
+
 	it("fits the OAuth clipboard status inside the login button", function()
 		local status = mock_tradeQuery:FormatOAuthLoginStatus(60)
 
